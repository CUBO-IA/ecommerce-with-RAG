  {
    "id": "table.Document",
    "label": "Create table \"Document\"",
    "summary": "Creates table \"Document\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "Document"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"Document\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"Document\""
        ],
        "expectation": {
          "expects": "absent",
          "object": "table \"Document\""
        }
      }
    ],
    "execute": [
      {
        "description": "create table \"Document\"",
        "sql": "CREATE TABLE \"public\".\"Document\" (\n  \"content\" text NOT NULL,\n  \"embedding\" vector(2048),\n  \"id\" SERIAL NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"Document\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_class\" AS \"c\" WHERE (\"c\".\"oid\" = to_regclass($1) AND (\"c\".\"relkind\" = $2 OR \"c\".\"relkind\" = $3))) AS \"result\"",
        "params": [
          "\"public\".\"Document\"",
          "r",
          "p"
        ],
        "expectation": {
          "expects": "present",
          "object": "table \"Document\""
        }
      }
    ]
  }
